---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
---

<Section background="dark">
  <SectionHeader
    title="See It In Action"
    subtitle="A glimpse into the beautiful interface and powerful features"
    gradient="cyan-blue"
  />

  <!-- TUI Dashboard showcase -->
  <div class="mb-16 md:mb-32">
    <Card hoverable={false} class="p-1 md:p-2">
      <div class="bg-slate-950/80 rounded-lg md:rounded-xl p-6 md:p-8">
        <img
          src="/tui-dashboard.png"
          alt="DevCLI TUI Dashboard showing process list and status"
          class="rounded-lg md:rounded-xl w-full h-auto shadow-xl"
          loading="lazy"
        />
      </div>
    </Card>
    <div class="text-center mt-6 md:mt-8">
      <h3 class="text-2xl md:text-3xl font-bold mb-3 md:mb-4 text-white">
        Interactive Dashboard
      </h3>
      <p class="text-slate-400 text-base md:text-lg max-w-3xl mx-auto">
        Monitor all your processes in real-time with a beautiful terminal UI.
        See status, uptime, logs, and health checks at a glance.
      </p>
    </div>
  </div>

  <!-- Split view: Logs + Terminal commands -->
  <div class="grid md:grid-cols-2 gap-6 md:gap-8 mb-16 md:mb-32">
    <!-- Log viewer -->
    <div>
      <Card hoverable={false} class="p-1 md:p-2">
        <div class="bg-slate-950/80 rounded-lg md:rounded-xl p-6 md:p-8">
          <img
            src="/tui-logs.png"
            alt="DevCLI TUI log viewer with multi-app streaming"
            class="rounded-lg w-full h-auto shadow-xl"
            loading="lazy"
          />
        </div>
      </Card>
      <div class="mt-4 md:mt-6">
        <h3 class="text-xl md:text-2xl font-bold mb-2 md:mb-3 text-white">Live Log Streaming</h3>
        <p class="text-sm md:text-base text-slate-400">
          Watch logs from multiple apps simultaneously with full ANSI color support and smart filtering.
        </p>
      </div>
    </div>

    <!-- Terminal commands -->
    <div>
      <Card hoverable={false} class="p-1 md:p-2">
        <div class="bg-slate-950/80 rounded-lg md:rounded-xl p-6 md:p-8">
          <img
            src="/terminal-status.png"
            alt="DevCLI status command showing colorful process information"
            class="rounded-lg w-full h-auto shadow-xl"
            loading="lazy"
          />
        </div>
      </Card>
      <div class="mt-4 md:mt-6">
        <h3 class="text-xl md:text-2xl font-bold mb-2 md:mb-3 text-white">Beautiful CLI</h3>
        <p class="text-sm md:text-base text-slate-400">
          Intuitive commands with rich, colorful output that makes process management a joy.
        </p>
      </div>
    </div>
  </div>

  <!-- Configuration example -->
  <Card hoverable={false} class="bg-gradient-to-br from-blue-600/10 to-cyan-600/10 border-cyan-500/20">
    <div class="max-w-5xl mx-auto">
      <h3 class="text-2xl md:text-3xl font-bold mb-6 md:mb-8 text-center text-white">
        Simple Yet Powerful Configuration
      </h3>
      <div class="bg-slate-950/80 rounded-lg md:rounded-xl p-1 md:p-2 border border-slate-800">
        <img
          src="/tui-config.png"
          alt="DevCLI configuration file example"
          class="rounded-lg w-full h-auto shadow-xl"
          loading="lazy"
        />
      </div>
    </div>
  </Card>
</Section>
