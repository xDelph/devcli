---
// Showcase section with TUI screenshots
---

<section class="relative py-32 px-4 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
  <div class="max-w-7xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-20">
      <h2 class="text-5xl md:text-6xl font-black mb-6 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">
        See It In Action
      </h2>
      <p class="text-xl text-slate-400 max-w-2xl mx-auto">
        A glimpse into the beautiful interface and powerful features
      </p>
    </div>

    <!-- TUI Dashboard showcase -->
    <div class="mb-32">
      <div class="bg-slate-900/50 backdrop-blur-xl rounded-3xl p-2 border border-slate-800 shadow-2xl">
        <div class="bg-slate-950/80 rounded-2xl p-8">
          <!-- [IMAGE PLACEHOLDER: TUI Dashboard] -->
          <div class="aspect-video bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl flex items-center justify-center border border-slate-700">
            <div class="text-center">
              <svg class="w-32 h-32 mx-auto mb-6 text-cyan-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <p class="text-slate-400 font-mono text-lg mb-2">TUI Dashboard Screenshot</p>
              <p class="text-slate-600 text-sm">Main interface showing process list, status, and navigation</p>
            </div>
          </div>
        </div>
      </div>
      <div class="text-center mt-8">
        <h3 class="text-3xl font-bold mb-4 text-white">
          Interactive Dashboard
        </h3>
        <p class="text-slate-400 text-lg max-w-3xl mx-auto">
          Monitor all your processes in real-time with a beautiful terminal UI.
          See status, uptime, logs, and health checks at a glance.
        </p>
      </div>
    </div>

    <!-- Split view: Logs + Terminal commands -->
    <div class="grid lg:grid-cols-2 gap-8 mb-32">
      <!-- Log viewer -->
      <div>
        <div class="bg-slate-900/50 backdrop-blur-xl rounded-2xl p-2 border border-slate-800 shadow-xl hover:border-cyan-500/30 transition-all duration-500">
          <div class="bg-slate-950/80 rounded-xl p-6">
            <!-- [IMAGE PLACEHOLDER: Log viewer] -->
            <div class="aspect-video bg-gradient-to-br from-slate-800 to-slate-900 rounded-lg flex items-center justify-center border border-slate-700">
              <div class="text-center">
                <svg class="w-24 h-24 mx-auto mb-4 text-green-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <p class="text-slate-500 font-mono text-sm">Live Log Viewer</p>
                <p class="text-slate-600 text-xs mt-2">Multi-app log streaming with colors</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-3 text-white">Live Log Streaming</h3>
          <p class="text-slate-400">
            Watch logs from multiple apps simultaneously with full ANSI color support and smart filtering.
          </p>
        </div>
      </div>

      <!-- Terminal commands -->
      <div>
        <div class="bg-slate-900/50 backdrop-blur-xl rounded-2xl p-2 border border-slate-800 shadow-xl hover:border-cyan-500/30 transition-all duration-500">
          <div class="bg-slate-950/80 rounded-xl p-6">
            <!-- [IMAGE PLACEHOLDER: Terminal commands] -->
            <div class="aspect-video bg-gradient-to-br from-slate-800 to-slate-900 rounded-lg flex items-center justify-center border border-slate-700">
              <div class="text-center">
                <svg class="w-24 h-24 mx-auto mb-4 text-blue-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <p class="text-slate-500 font-mono text-sm">Status Command Output</p>
                <p class="text-slate-600 text-xs mt-2">Colorful process status table</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-3 text-white">Beautiful CLI</h3>
          <p class="text-slate-400">
            Intuitive commands with rich, colorful output that makes process management a joy.
          </p>
        </div>
      </div>
    </div>

    <!-- Configuration example -->
    <div class="bg-gradient-to-br from-blue-600/10 to-cyan-600/10 rounded-3xl p-12 border border-cyan-500/20">
      <div class="max-w-5xl mx-auto">
        <h3 class="text-3xl font-bold mb-8 text-center text-white">
          Simple Yet Powerful Configuration
        </h3>
        <div class="bg-slate-950/80 rounded-xl p-2 border border-slate-800">
          <!-- [IMAGE PLACEHOLDER: Config example] -->
          <div class="aspect-[16/9] bg-gradient-to-br from-slate-900 to-slate-950 rounded-lg flex items-center justify-center border border-slate-700">
            <div class="text-center p-8">
              <svg class="w-24 h-24 mx-auto mb-4 text-cyan-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
              <p class="text-slate-500 font-mono text-sm">YAML Configuration Example</p>
              <p class="text-slate-600 text-xs mt-2">Clean syntax with health checks, dependencies, and multi-env support</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
