---
import CodeBlock from './ui/CodeBlock.astro';
import Card from './ui/Card.astro';
import { Image } from 'astro:assets';
import heroDemo from '../assets/images/hero-terminal-demo.gif';
---

<section class="relative flex items-center justify-center overflow-hidden px-6 py-12 md:py-20 border-b border-[var(--border)] hero-section">
  <!-- Animated background elements -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none opacity-40">
    <div class="absolute top-[10%] left-[5%] w-72 h-72 bg-blue-500/10 rounded-full blur-[120px] animate-pulse-slow"></div>
    <div class="absolute bottom-[10%] right-[5%] w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px] animate-pulse-slow" style="animation-delay: 2s;"></div>
  </div>

  <div class="relative max-w-6xl mx-auto text-center z-10 w-full">
    <!-- Booting Sequence -->
    <div class="mb-8 font-mono text-[8px] md:text-xs text-[var(--text-muted)] flex justify-center gap-2 md:gap-4 flex-wrap uppercase tracking-tighter md:tracking-normal">
      <span class="reveal-item" style="transition-delay: 0.1s;">[ STATUS: OK ]</span>
      <span class="reveal-item" style="transition-delay: 0.2s;">[ ARCH: ARM64 ]</span>
      <span class="reveal-item" style="transition-delay: 0.3s;">[ CORE: RUST ]</span>
      <span class="reveal-item text-green-500" style="transition-delay: 0.4s;">[ MONITOR: ONLINE ]</span>
    </div>

    <!-- Main heading -->
    <div class="mb-12">
      <h1 class="text-[clamp(2.5rem,15vw,8rem)] font-black mb-6 bg-gradient-to-r from-blue-400 via-cyan-400 to-teal-400 bg-clip-text text-transparent leading-[0.85] tracking-tighter reveal-item whitespace-nowrap brand-title">
        DEVCLI<span class="animate-blink text-[var(--accent)]">_</span>
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl font-bold text-[var(--text-main)] mb-6 font-mono tracking-tight reveal-item subtitle-text" style="transition-delay: 0.2s;">
        &gt; ORCHESTRATE_YOUR_<span class="text-[var(--accent)]">WORKFLOW</span>
      </p>
      <p class="text-sm sm:text-base md:text-lg text-[var(--text-muted)] max-w-2xl mx-auto leading-relaxed font-mono reveal-item" style="transition-delay: 0.3s;">
        The terminal-first process manager built for speed and reliability.
        Manage complex environments without leaving your shell.
      </p>
    </div>

    <!-- Installation command -->
    <div class="mb-16 reveal-item" style="transition-delay: 0.4s;">
      <div class="w-full max-w-2xl mx-auto text-left">
        <CodeBlock
          code="curl -fsSL https://raw.githubusercontent.com/xDelph/devcli/develop/install.sh | sh"
          copyable={true}
          title="quick_install.sh"
        />
        <div class="mt-4 flex justify-center gap-6">
          <a href="#installation" class="text-[10px] md:text-xs font-mono text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors uppercase tracking-widest flex items-center gap-2">
            <span class="text-[var(--accent)]">01.</span> view_install_methods()
          </a>
          <a href="/docs/getting-started" class="text-[10px] md:text-xs font-mono text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors uppercase tracking-widest flex items-center gap-2">
            <span class="text-[var(--accent)]">02.</span> read_documentation()
          </a>
        </div>
      </div>
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-4 justify-center mb-24 reveal-item" style="transition-delay: 0.5s;">
      <a href="#features" class="px-6 py-3 md:px-8 md:py-4 bg-blue-600 text-white font-bold rounded-sm hover:bg-blue-500 transition-all active:scale-95 border-b-4 border-blue-800 flex items-center gap-2 text-sm md:text-base cta-primary text-center justify-center">
        <span>EXPLORE_FEATURES</span>
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a href="/docs/getting-started" class="px-6 py-3 md:px-8 md:py-4 bg-slate-800 text-white font-bold rounded-sm hover:bg-slate-700 transition-all active:scale-95 border-b-4 border-slate-900 flex items-center gap-2 text-sm md:text-base text-center justify-center">
        <span>READ_DOCS</span>
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.247 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
      </a>
      <a href="https://github.com/xDelph/devcli" target="_blank" class="px-6 py-3 md:px-8 md:py-4 bg-slate-800 text-white font-bold rounded-sm hover:bg-slate-700 transition-all active:scale-95 border-b-4 border-slate-900 flex items-center gap-2 text-sm md:text-base text-center justify-center">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.082.824-.26.824-.583 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
        </svg>
        <span>GITHUB_REPRO</span>
      </a>
    </div>

    <!-- Terminal demo animation -->
    <div class="max-w-5xl mx-auto reveal-item w-full" style="transition-delay: 0.6s;">
      <div class="relative bg-[var(--border)] rounded-sm border border-[var(--border)] shadow-[0_0_50px_rgba(0,0,0,0.5)] terminal-frame text-left overflow-hidden w-full">
        <!-- Terminal Header -->
        <div class="flex items-center justify-between px-4 py-2 bg-[var(--terminal-header)] border-b border-[var(--border)]">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500/20"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/20"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/20"></div>
            </div>
            <span class="ml-2 text-[10px] font-mono text-[var(--text-muted)] uppercase tracking-widest">devcli_monitor --all</span>
          </div>
          <div class="text-[10px] font-mono text-[var(--text-muted)] tracking-tighter">
            USER: xDelph | CPU: 1.2%
          </div>
        </div>
        
        <div class="bg-[var(--bg-main)] terminal-body overflow-hidden p-0 w-full cursor-zoom-in">
          <Image
            src={heroDemo}
            alt="DevCLI terminal demo showing process management commands"
            class="w-full h-auto opacity-90 grayscale-[0.2] contrast-[1.1] brightness-[1.1] terminal-image block object-cover zoomable"
          />
        </div>
        
        <!-- Subtle scanline overlay just for the image -->
        <div class="absolute inset-0 pointer-events-none opacity-[0.05] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px]"></div>
      </div>
    </div>
  </div>
</section>

<style>
  :root[data-theme="terminal"] .brand-title {
    background: none;
    -webkit-text-fill-color: initial;
    color: #4ade80;
  }
  
  :root[data-theme="terminal"] .cta-primary {
    background-color: #166534;
    border-bottom-color: #052e16;
  }
  
  :root[data-theme="terminal"] .cta-primary:hover {
    background-color: #15803d;
  }

  :root[data-theme="light"] .terminal-frame {
    border-color: #e2e8f0;
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }
  
  :root[data-theme="light"] .terminal-body {
    background-color: #ffffff;
  }
  
  :root[data-theme="light"] .terminal-image {
    grayscale: 0;
    opacity: 1;
  }
</style>
