---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';

const comparisons = [
  {
    tool: 'PM2',
    devCLIAdvantages: [
      'Native health checks (no modules)',
      'Built-in TUI interface',
      'Better dependency management',
      'Docker/OrbStack native support'
    ]
  },
  {
    tool: 'Docker Compose',
    devCLIAdvantages: [
      'Mixed environments (local + Docker)',
      'Interactive TUI monitoring',
      'Advanced restart policies',
      'Health check retry logic'
    ]
  },
  {
    tool: 'Custom Scripts',
    devCLIAdvantages: [
      'No bash scripting needed',
      'Declarative configuration',
      'Built-in monitoring',
      'Cross-platform support'
    ]
  }
];
---

<Section background="dark">
  <SectionHeader
    title="Why DevCLI?"
    subtitle="Built for modern development workflows"
    gradient="cyan-blue"
  />

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {comparisons.map((comparison) => (
      <Card hoverable={false}>
        <div class="flex items-center justify-between mb-4 md:mb-6">
          <h3 class="text-xl md:text-2xl font-bold text-white">vs {comparison.tool}</h3>
          <svg class="w-6 h-6 md:w-8 md:h-8 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>

        <ul class="space-y-3 md:space-y-4">
          {comparison.devCLIAdvantages.map(advantage => (
            <li class="flex items-start gap-2 md:gap-3">
              <svg class="w-4 h-4 md:w-5 md:h-5 text-green-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-sm md:text-base text-slate-300">{advantage}</span>
            </li>
          ))}
        </ul>
      </Card>
    ))}
  </div>
</Section>
