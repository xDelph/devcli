---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';

const comparisons = [
  {
    tool: 'PM2',
    devCLIAdvantages: [
      'NATIVE_HEALTH_CHECKS',
      'BUILTIN_TUI_VIEWER',
      'TOPOLOGICAL_SORTING',
      'ORBSTACK_READY'
    ]
  },
  {
    tool: 'DOCKER_COMPOSE',
    devCLIAdvantages: [
      'HYBRID_ENV_MODES',
      'INTERACTIVE_CONTROL',
      'EXPONENTIAL_BACKOFF',
      'RETRY_LOGIC_V2'
    ]
  },
  {
    tool: 'CUSTOM_SCRIPTS',
    devCLIAdvantages: [
      'ZERO_MAINTENANCE',
      'DECLARATIVE_JSON',
      'CENTRALIZED_LOGS',
      'X_PLATFORM_CORE'
    ]
  }
];
---

<Section background="dark">
  <SectionHeader
    title="Competitive Edge"
    subtitle="How DevCLI compares to common alternatives"
    gradient="cyan-blue"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 reveal-item">
    {comparisons.map((comparison) => (
      <div class="bg-[var(--bg-card)] border border-[var(--border)] p-6 md:p-8 hover:border-[var(--accent)]/30 transition-colors group">
        <div class="flex items-center gap-3 md:gap-4 mb-8 md:mb-10 pb-4 border-b border-[var(--border)]">
          <div class="w-2 h-2 bg-[var(--accent)] rounded-full animate-pulse"></div>
          <h3 class="text-lg md:text-xl font-black text-[var(--text-main)] tracking-tighter uppercase font-mono truncate">
            vs_{comparison.tool.toLowerCase()}
          </h3>
        </div>

        <ul class="space-y-4 md:space-y-6">
          {comparison.devCLIAdvantages.map(advantage => (
            <li class="flex items-start gap-3 md:gap-4 font-mono text-[10px] md:text-xs">
              <span class="text-green-500 mt-0.5 select-none">[+]</span>
              <span class="text-[var(--text-muted)] group-hover:text-[var(--text-main)] transition-colors leading-relaxed">{advantage}</span>
            </li>
          ))}
        </ul>
        
        <div class="mt-12 pt-6 border-t border-[var(--border)] flex justify-between items-center opacity-30 group-hover:opacity-100 transition-opacity">
          <span class="text-[8px] font-mono text-[var(--text-muted)] uppercase tracking-widest">STATUS: FEATURE_MATRIX</span>
          <span class="text-[8px] font-mono text-[var(--text-muted)] uppercase tracking-widest">DEVCLI_VS_{comparison.tool.toLowerCase()}</span>
        </div>
      </div>
    ))}
  </div>
</Section>
