---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';

const features = [
  {
    icon: '🚀',
    title: 'Auto-Restart Policies',
    description: 'Configurable restart on crash with exponential backoff, max restart limits, and smart failure detection.',
    gradient: 'from-blue-500 to-cyan-500'
  },
  {
    icon: '💚',
    title: 'Health Checks',
    description: 'HTTP, TCP, and command-based health monitoring with automatic restart on failure detection.',
    gradient: 'from-green-500 to-emerald-500'
  },
  {
    icon: '📊',
    title: 'Built-in TUI',
    description: 'Real-time dashboard with live logs, process status, and interactive management. No external tools needed.',
    gradient: 'from-purple-500 to-pink-500'
  },
  {
    icon: '🔄',
    title: 'Dependencies',
    description: 'Smart dependency resolution with automatic startup ordering and cascading restarts.',
    gradient: 'from-orange-500 to-red-500'
  },
  {
    icon: '📝',
    title: 'Metrics & Logging',
    description: 'JSON structured logs, process metrics, performance tracking, and HTTP metrics API endpoint.',
    gradient: 'from-cyan-500 to-blue-500'
  },
  {
    icon: '🐳',
    title: 'Docker & OrbStack',
    description: 'Native Docker support with env injection, multi-stage builds, and OrbStack optimizations.',
    gradient: 'from-indigo-500 to-purple-500'
  }
];
---

<Section id="features" background="gradient">
  <SectionHeader
    title="Packed with Power"
    subtitle="Everything you need to manage complex development environments with ease"
  />

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {features.map((feature) => (
      <Card>
        <div class={`inline-flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-xl bg-gradient-to-br ${feature.gradient} mb-4 md:mb-6 text-2xl md:text-3xl group-hover:scale-110 transition-transform duration-300`}>
          {feature.icon}
        </div>

        <h3 class="text-xl md:text-2xl font-bold mb-3 md:mb-4 text-white group-hover:text-cyan-400 transition-colors">
          {feature.title}
        </h3>

        <p class="text-sm md:text-base text-slate-400 leading-relaxed">
          {feature.description}
        </p>
      </Card>
    ))}
  </div>

  <Card hoverable={false} class="mt-12 md:mt-20 bg-gradient-to-r from-blue-600/10 to-cyan-600/10 border-cyan-500/20">
    <div class="max-w-4xl mx-auto text-center">
      <h3 class="text-2xl md:text-3xl font-bold mb-3 md:mb-4 text-white">
        And that's just the beginning...
      </h3>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed">
        Multi-environment configuration, stage support, privacy-friendly alternative names,
        Nx monorepo detection, environment variable management, and much more. DevCLI grows with your needs.
      </p>
    </div>
  </Card>
</Section>
