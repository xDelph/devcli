---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import CodeBlock from './ui/CodeBlock.astro';

const installMethods = [
  {
    name: 'Quick Install',
    description: 'Recommended for most users',
    command: 'curl -fsSL https://raw.githubusercontent.com/xDelph/devcli/main/install.sh | sh',
    icon: '⚡'
  },
  {
    name: 'Homebrew',
    description: 'macOS & Linux package manager',
    command: 'brew tap xDelph/devcli && brew install devcli',
    icon: '🍺',
    link: '#installation',
    linkText: 'See all install options'
  },
  {
    name: 'Manual Download',
    description: 'Download binaries directly',
    command: '# See GitHub releases for platform-specific binaries',
    icon: '📦',
    link: 'https://github.com/xDelph/devcli/releases'
  }
];
---

<Section id="installation">
  <SectionHeader
    title="Get Started in Seconds"
    subtitle="Choose your preferred installation method"
  />

  <!-- Installation methods -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mb-16 md:mb-20">
    {installMethods.map((method) => (
      <Card>
        <div class="text-4xl md:text-5xl mb-4">{method.icon}</div>

        <h3 class="text-xl md:text-2xl font-bold mb-2 text-white">{method.name}</h3>
        <p class="text-slate-500 text-sm mb-6">{method.description}</p>

        <CodeBlock code={method.command} copyable={true} class="mb-4" />

        {method.link && (
          <a
            href={method.link}
            target={method.link.startsWith('http') ? '_blank' : undefined}
            class="inline-flex items-center text-cyan-400 hover:text-cyan-300 transition-colors text-sm font-medium"
          >
            {method.linkText || 'View releases'}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        )}
      </Card>
    ))}
  </div>

  <!-- Quick start steps -->
  <Card hoverable={false} class="bg-gradient-to-br from-slate-900 to-slate-950">
    <h3 class="text-2xl md:text-3xl font-bold mb-8 md:mb-12 text-center text-white">
      Your First Steps
    </h3>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br from-blue-600 to-cyan-600 text-white font-bold text-lg md:text-xl mb-3 md:mb-4">
          1
        </div>
        <h4 class="text-base md:text-lg font-semibold mb-2 text-white">Install</h4>
        <p class="text-slate-400 text-xs md:text-sm">Run the install command</p>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br from-cyan-600 to-teal-600 text-white font-bold text-lg md:text-xl mb-3 md:mb-4">
          2
        </div>
        <h4 class="text-base md:text-lg font-semibold mb-2 text-white">Initialize</h4>
        <p class="text-slate-400 text-xs md:text-sm">Run <code class="text-cyan-400 font-mono text-xs">devcli config init</code></p>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br from-teal-600 to-green-600 text-white font-bold text-lg md:text-xl mb-3 md:mb-4">
          3
        </div>
        <h4 class="text-base md:text-lg font-semibold mb-2 text-white">Auto-Add</h4>
        <p class="text-slate-400 text-xs md:text-sm">Discover apps with <code class="text-cyan-400 font-mono text-xs">devcli auto-add</code></p>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 md:w-16 md:h-16 rounded-full bg-gradient-to-br from-green-600 to-emerald-600 text-white font-bold text-lg md:text-xl mb-3 md:mb-4">
          4
        </div>
        <h4 class="text-base md:text-lg font-semibold mb-2 text-white">Start!</h4>
        <p class="text-slate-400 text-xs md:text-sm">Launch with <code class="text-cyan-400 font-mono text-xs">devcli start</code></p>
      </div>
    </div>
  </Card>
</Section>
