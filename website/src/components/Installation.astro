---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import CodeBlock from './ui/CodeBlock.astro';

const installMethods = [
  {
    name: 'QUICK_INSTALL',
    description: 'Recommended for most environments',
    command: 'curl -fsSL https://raw.githubusercontent.com/xDelph/devcli/develop/install.sh | sh',
    icon: '⚡'
  },
  {
    name: 'HOMEBREW_TAP',
    description: 'macOS & Linux package manager',
    command: 'brew tap xDelph/devcli && brew install devcli',
    icon: '🍺',
    link: '#installation',
    linkText: 'SEE_ALL_OPTIONS'
  }
];
---

<Section id="installation">
  <SectionHeader
    title="Deployment"
    subtitle="Inject DevCLI into your workflow in seconds"
  />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
    {installMethods.map((method) => (
      <Card class="flex flex-col h-full">
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-xl font-black text-[var(--text-main)] tracking-tighter">{method.name}</h3>
          <div class="text-2xl grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all">
            {method.icon}
          </div>
        </div>
        
        <p class="text-[var(--text-muted)] font-mono text-sm mb-8 flex-1">
          // {method.description}
        </p>

        <CodeBlock code={method.command} copyable={true} class="mt-auto" />

        {method.link && (
          <div class="mt-6">
            <a
              href={method.link}
              class="inline-flex items-center text-[10px] font-mono text-[var(--accent)] hover:text-[var(--text-main)] transition-colors"
            >
              [ {method.linkText} ]
            </a>
          </div>
        )}
      </Card>
    ))}
  </div>

  <!-- Progress Flow -->
  <div class="reveal-item">
    <div class="bg-[var(--bg-card)] border border-[var(--border)] p-8 md:p-12 relative overflow-hidden">
      <!-- Background ASCII graphic -->
      <div class="absolute right-0 top-0 text-[150px] font-black text-[var(--text-muted)] opacity-[0.03] leading-none select-none pointer-events-none">
        FLOW
      </div>

      <h3 class="text-2xl font-black mb-12 text-[var(--text-main)] font-mono tracking-tighter">
        &gt; INITIAL_SETUP_PROTOCOL
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 relative text-center md:text-left">
        <!-- Connecting lines -->
        <div class="hidden md:block absolute top-8 left-0 w-full h-0.5 bg-[var(--border)] -z-0"></div>

        {[
          { step: '01', title: 'INSTALL', cmd: 'curl | sh' },
          { step: '02', title: 'INIT', cmd: 'config init' },
          { step: '03', title: 'DETECT', cmd: 'auto-add' },
          { step: '04', title: 'START', cmd: 'start' }
        ].map((item) => (
          <div class="relative z-10 group">
            <div class="w-12 h-12 md:w-16 md:h-16 rounded-sm bg-[var(--bg-main)] border-2 border-[var(--border)] flex items-center justify-center text-lg md:text-xl font-black text-[var(--text-muted)] group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-all mb-4 mx-auto md:mx-0 shadow-lg">
              {item.step}
            </div>
            <h4 class="text-[var(--text-main)] font-black text-[10px] md:text-sm mb-1 md:mb-2 tracking-widest">{item.title}</h4>
            <code class="block text-[8px] md:text-[10px] text-[var(--text-muted)] font-mono bg-[var(--bg-main)] p-1 rounded-sm truncate border border-[var(--border)]">
              {item.cmd}
            </code>
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>
