---
// Footer component
---

<footer class="relative py-12 md:py-20 px-4 border-t border-slate-800">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-8 md:mb-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-2">
        <h3 class="text-2xl md:text-3xl font-black mb-3 md:mb-4 bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
          DevCLI
        </h3>
        <p class="text-sm md:text-base text-slate-400 mb-4 md:mb-6 leading-relaxed max-w-md">
          Powerful process management CLI for developers. Built with Rust for performance and reliability.
        </p>
        <div class="flex gap-4">
          <a href="https://github.com/xDelph/devcli" target="_blank" class="text-slate-400 hover:text-cyan-400 transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links - Resources -->
      <div>
        <h4 class="text-white font-semibold text-sm md:text-base mb-3 md:mb-4">Resources</h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="/docs/getting-started" class="text-xs md:text-sm text-slate-400 hover:text-cyan-400 transition-colors">
              Documentation
            </a>
          </li>
          <li>
            <a href="https://github.com/xDelph/devcli/releases" target="_blank" class="text-xs md:text-sm text-slate-400 hover:text-cyan-400 transition-colors">
              Releases
            </a>
          </li>
          <li>
            <a href="https://github.com/xDelph/devcli/blob/develop/CHANGELOG.md" target="_blank" class="text-xs md:text-sm text-slate-400 hover:text-cyan-400 transition-colors">
              Changelog
            </a>
          </li>
        </ul>
      </div>

      <!-- Links - Community -->
      <div>
        <h4 class="text-white font-semibold text-sm md:text-base mb-3 md:mb-4">Community</h4>
        <ul class="space-y-2 md:space-y-3">
          <li>
            <a href="https://github.com/xDelph/devcli" target="_blank" class="text-xs md:text-sm text-slate-400 hover:text-cyan-400 transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://github.com/xDelph/devcli/issues" target="_blank" class="text-xs md:text-sm text-slate-400 hover:text-cyan-400 transition-colors">
              Issues
            </a>
          </li>
          <li>
            <a href="https://github.com/xDelph/devcli/blob/main/CONTRIBUTING.md" target="_blank" class="text-xs md:text-sm text-slate-400 hover:text-cyan-400 transition-colors">
              Contributing
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 md:pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-3 md:gap-4 text-center md:text-left">
      <p class="text-slate-500 text-xs md:text-sm">
        © 2026 DevCLI. Licensed under PolyForm Noncommercial 1.0.0
      </p>
      <p class="text-slate-500 text-xs md:text-sm">
        Built with 💙 by <a href="https://github.com/xDelph" target="_blank" class="text-cyan-400 hover:text-cyan-300 transition-colors">xDelph</a>
      </p>
    </div>
  </div>
</footer>
