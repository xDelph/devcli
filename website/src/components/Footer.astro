---
// Footer component - Compact TUI Multi-column
---

<footer class="relative mt-auto border-t border-[var(--border)] bg-[var(--bg-main)] py-8 md:py-10 px-6 font-mono text-[10px]">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-8">
      <!-- Column 1: Brand -->
      <div class="col-span-2">
        <h3 class="text-xl font-black text-[var(--text-main)] tracking-tighter uppercase brand-glow mb-3">
          DEVCLI<span class="text-[var(--text-muted)] font-normal">_</span>
        </h3>
        <p class="text-[var(--text-muted)] leading-relaxed uppercase tracking-wider max-w-xs mb-4">
          // High-performance process orchestration<br/>
          // Built with Rust for maximum reliability
        </p>
        <div class="flex gap-4">
          <div class="flex flex-col gap-0.5">
            <span class="text-[var(--accent)] opacity-50 text-[8px]">STATUS</span>
            <span class="text-[var(--text-main)] flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-green-500 animate-pulse"></span> READY_STABLE
            </span>
          </div>
          <div class="flex flex-col gap-0.5 border-l border-[var(--border)] pl-4">
            <span class="text-[var(--accent)] opacity-50 text-[8px]">VERSION</span>
            <span class="text-[var(--text-main)]">0.1.0_LATEST</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Resources -->
      <div class="flex flex-col gap-3">
        <h4 class="font-black text-[var(--text-main)] uppercase tracking-[0.2em] opacity-50 border-b border-[var(--border)] pb-1.5">
          01_RESOURCES
        </h4>
        <nav class="flex flex-col gap-1.5 uppercase tracking-widest">
          <a href="/docs/getting-started" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
            -- documentation.md
          </a>
          <a href="https://github.com/xDelph/devcli/releases" target="_blank" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
            -- binary_releases.gz
          </a>
          <a href="https://github.com/xDelph/devcli/blob/develop/CHANGELOG.md" target="_blank" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
            -- changelog.json
          </a>
        </nav>
      </div>

      <!-- Column 3: Source -->
      <div class="flex flex-col gap-3">
        <h4 class="font-black text-[var(--text-main)] uppercase tracking-[0.2em] opacity-50 border-b border-[var(--border)] pb-1.5">
          02_NETWORK
        </h4>
        <nav class="flex flex-col gap-1.5 uppercase tracking-widest">
          <a href="https://github.com/xDelph/devcli" target="_blank" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
            -- github_origin
          </a>
          <a href="https://github.com/xDelph/devcli/issues" target="_blank" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
            -- report_issue.sh
          </a>
          <a href="https://github.com/xDelph/devcli/blob/main/CONTRIBUTING.md" target="_blank" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">
            -- contribute.cpp
          </a>
        </nav>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-[var(--border)] flex flex-col md:flex-row justify-between items-center gap-4 opacity-50">
      <div class="flex items-center gap-4 uppercase tracking-tighter">
        <span>© 2026 devcli_project</span>
        <span class="w-1 h-1 bg-[var(--border)] rounded-full"></span>
        <span>Licensed_under_polyform_nc_1.0.0</span>
      </div>
      <div class="uppercase tracking-widest">
        AUTH: <a href="https://github.com/xDelph" target="_blank" class="text-[var(--text-main)] hover:text-[var(--accent)] transition-all">@XDELPH</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    z-index: 40;
  }

  .brand-glow {
    text-shadow: 0 0 15px rgba(var(--accent), 0.1);
  }
</style>
