---
interface Props {
  code: string;
  copyable?: boolean;
  class?: string;
  title?: string;
}

const { code, copyable = false, class: className = '', title = 'terminal' } = Astro.props;
---

<div class={`flex flex-col bg-[var(--code-bg)] rounded-sm border border-[var(--border)] overflow-hidden shadow-2xl ${className}`}>
  <!-- Terminal Header -->
  <div class="flex items-center justify-between px-4 py-2 bg-[var(--terminal-header)] border-b border-[var(--border)]">
    <div class="flex items-center gap-2">
      <div class="flex gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-slate-700/50"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-slate-700/50"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-slate-700/50"></div>
      </div>
      <span class="ml-2 text-[10px] font-mono text-[var(--text-muted)] uppercase tracking-widest">{title}</span>
    </div>
    {copyable && (
      <button
        class="copy-btn text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors flex items-center gap-1.5 group"
        data-code={code}
        aria-label="Copy to clipboard"
      >
        <span class="text-[10px] font-mono opacity-0 group-hover:opacity-100 transition-opacity">COPY</span>
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
      </button>
    )}
  </div>

  <div class="p-4 md:p-6 overflow-x-auto custom-scrollbar">
    <div class="flex gap-4">
      <span class="text-[var(--text-muted)] opacity-50 select-none font-mono text-sm sm:text-base">$</span>
      <code class="text-[var(--accent)] font-mono text-sm sm:text-base break-all flex-1">
        {code}
      </code>
    </div>
  </div>
</div>

<script>
  // Handled globally or locally in the component
  const copyButtons = document.querySelectorAll('.copy-btn');
  
  copyButtons.forEach(button => {
    button.addEventListener('click', () => {
      const code = button.getAttribute('data-code');
      if (code) {
        navigator.clipboard.writeText(code).then(() => {
          const originalHTML = button.innerHTML;
          button.innerHTML = '<span class="text-[10px] font-mono text-green-500">COPIED!</span><svg class="w-4 h-4 text-green-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
          
          setTimeout(() => {
            button.innerHTML = originalHTML;
          }, 2000);
        });
      }
    });
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }
</style>
