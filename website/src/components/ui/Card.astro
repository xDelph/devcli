---
interface Props {
  class?: string;
  hoverable?: boolean;
}

const { class: className = '', hoverable = true } = Astro.props;

const hoverClass = hoverable
  ? 'hover:border-[var(--accent)]/50 hover:shadow-[0_0_30px_rgba(6,182,212,0.05)] hover:-translate-y-1'
  : '';
---

<div class={`relative bg-[var(--bg-card)] backdrop-blur-sm p-6 md:p-8 border border-[var(--border)] transition-all duration-300 group ${hoverClass} ${className}`}>
  <!-- Terminal ASCII Corners -->
  <div class="absolute -top-px -left-px w-3 h-3 border-t-2 border-l-2 border-[var(--border)] group-hover:border-[var(--accent)] transition-colors"></div>
  <div class="absolute -top-px -right-px w-3 h-3 border-t-2 border-r-2 border-[var(--border)] group-hover:border-[var(--accent)] transition-colors"></div>
  <div class="absolute -bottom-px -left-px w-3 h-3 border-b-2 border-l-2 border-[var(--border)] group-hover:border-[var(--accent)] transition-colors"></div>
  <div class="absolute -bottom-px -right-px w-3 h-3 border-b-2 border-r-2 border-[var(--border)] group-hover:border-[var(--accent)] transition-colors"></div>
  
  <!-- Subtle Background Grid for the card -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iMTAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHJlY3Qgd2lkdGg9IjEiIGhlaWdodD0iMSIgZmlsbD0id2hpdGUiLz48L3N2Zz4=')]"></div>

  <div class="relative z-10 h-full">
    <slot />
  </div>
</div>
