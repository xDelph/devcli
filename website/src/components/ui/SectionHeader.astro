---
interface Props {
  title: string;
  subtitle?: string;
  gradient?: 'blue-cyan' | 'cyan-blue';
}

const { title, subtitle, gradient = 'blue-cyan' } = Astro.props;

const gradientClasses = {
  'blue-cyan': 'from-blue-400 to-cyan-400',
  'cyan-blue': 'from-cyan-400 to-blue-400'
};
---

<div class="text-center mb-16 md:mb-20">
  <h2 class={`text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black mb-6 md:mb-8 bg-gradient-to-r ${gradientClasses[gradient]} bg-clip-text text-transparent leading-tight`}>
    {title}
  </h2>
  {subtitle && (
    <p class="text-xl sm:text-2xl md:text-3xl text-slate-400 max-w-4xl mx-auto leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
